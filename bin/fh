#!/usr/bin/env bash
# fh against a pog world. POG_WORLD selects the instance (default live); RCON reaches it through the SSH tunnel.
# Agent workspaces under the RCON broker (POG_BROKER=1, tools/fh_broker.py) pass POG_FH_SOCKET instead: the broker
# holds the password and forwards only that bot's harness requests.
if [ -n "${POG_FH_SOCKET:-}" ]; then
  exec env -u FACTORIO_RCON_PASSWORD -u FACTORIO_RCON_PASSWORD_FILE FH_SOCKET="$POG_FH_SOCKET" \
    node "$(dirname "$0")/../vendor/factorio-harness/dist/host/cli.js" "$@"
fi
world=${POG_WORLD:-live}
case $world in
  live) port=27015 ;;
  a) port=27021 ;;
  b) port=27022 ;;
  c) port=27023 ;;
  n) port=27025 ;;
  sa) port=27030 ;;
  *) port=${POG_RCON_PORT:?set POG_RCON_PORT for world $world} ;;
esac
# Agent workspaces pass POG_RCON_PASSWORD_FILE (a per-run copy of this world's password, tools/new-run.sh).
export FACTORIO_RCON_HOST=127.0.0.1 FACTORIO_RCON_PORT=$port
export FACTORIO_RCON_PASSWORD_FILE=${POG_RCON_PASSWORD_FILE:-$HOME/.config/pog/rcon-$world.pw}
exec node "$(dirname "$0")/../vendor/factorio-harness/dist/host/cli.js" "$@"
